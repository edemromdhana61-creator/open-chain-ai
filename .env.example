# Open Chain AI Environment Variables

# API Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://openchain:openchain@localhost:5432/openchain

# Message Broker
NATS_URL=nats://localhost:4222

# Ollama Cloud (REQUIRED)
OLLAMA_HOST=https://api.ollama.com
OLLAMA_TOKEN=your-ollama-cloud-token-here

# JWT Secret (change in production!)
JWT_SECRET=change-this-in-production-32-characters

# Sandbox Limits
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_IMAGE=open-chain-ai/agent-sandbox:latest

# Circuit Breaker
CIRCUIT_BREAKER_MAX_REVISIONS=3
